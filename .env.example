# Hugging Face / model paths
BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
ADAPTER_PATH=/content/drive/MyDrive/texttosql/results/checkpoint-5300
MODEL_PATH=/content/drive/MyDrive/text2sql_qwen_merged
MODEL_VERSION=Qwen2.5-3B-Instruct-text2sql-v1
MAX_NEW_TOKENS=128

# CPU-only inference (no CUDA GPU available): set MERGED_MODEL_PATH to a
# merged model directory (base + LoRA merged via save_pretrained). Quantized
# 4-bit loading requires a GPU, so this path loads bf16/fp32 instead.
MERGED_MODEL_PATH=/content/drive/MyDrive/text2sql_qwen_merged
FORCE_CPU=false

# Database (read-only account only -- see SRS Section 14/19)
DB_TYPE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=readonly_user
DB_PASSWORD=

# Schema RAG (FAISS) -- stored on Google Drive in the Colab dev workflow
RAG_INDEX_PATH=/content/drive/MyDrive/text2sql_schema_faiss/schema.index
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Execution limits
ALLOW_LIMIT=100
QUERY_TIMEOUT_SECONDS=10

# Auth (comma-separated API keys; leave empty to disable auth in local dev)
API_KEYS=
RATE_LIMIT=30/minute

NGROK_AUTHTOKEN=
